{
  "view": {
    "type": "view.list",
    "items": [
      {
        "type": "layout.columns",
        "verticalAlign": "middle",
        "ratio":[1, 1],
        "minWidth": 500,
        "items": [
          {
              "type": "view.image",
              "ratio": [
                1,
                1
              ],
              "rotatable": true,
              "url": {
                "type": "data.input",
                "path": "image"
              }
          },
          {
              "type": "field.radio-group",
              "label": "Какая комната на изображении?",
              "options": [
                {
                  "label": "кухня / столовая",
                  "value": "0"
                },
                {
                  "label": "кухня-гостиная",
                  "value": "1"
                },
                {
                  "label": "универсальная комната",
                  "value": "2"
                },
                {
                  "label": "комната без мебели",
                  "value": "19"
                },
                {
                  "label": "гостиная",
                  "value": "3"
                },
                {
                  "label": "спальня",
                  "value": "4"
                },
                {
                  "label": "кабинет",
                  "value": "5"
                },
                {
                  "label": "детская",
                  "value": "6"
                },

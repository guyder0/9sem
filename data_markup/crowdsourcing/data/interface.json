                },
                {
                  "label": "гардеробная / кладовая / постирочная",
                  "value": "11"
                },
                {
                  "label": "балкон / лоджия",
                  "value": "12"
                },
                {
                  "label": "вид из окна / с балкона",
                  "value": "13"
                },
                {
                  "label": "дом снаружи / двор",
                  "value": "14"
                },
                {
                  "label": "подъезд / лестничная площадка",
                  "value": "15"
                },
                {
                  "label": "другое",
                  "value": "16"
                },
                {
                  "label": "предметы интерьера / быт.техника",
                  "value": "17"
                },
                {
                  "label": "не могу дать ответ / не ясно",
                  "value": "18"
                },
                {
                  "label": "ошибка загрузки изображения",
                  "value": "-1"
                }
              ],
              "data": {
                "type": "data.output",
                "path": "result"
              },
              "validation": {
                "type": "condition.required"
              }
          }
        ]
      }
    ]
  },
